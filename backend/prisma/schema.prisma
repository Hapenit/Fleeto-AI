enum ProcurementDecisionStatus {
  DRAFT
  PENDING_DECISION
  CONFIRMED
  CANCELLED
  SUPERSEDED
}

enum ProcurementItemDecisionStatus {
  SELECTED
  NOT_SELECTED
  REVIEWED
  NOT_REVIEWED
}

enum ProcurementDecisionAuditAction {
  DECISION_CREATED
  DECISION_VIEWED
  QUOTATION_REVIEWED
  EVIDENCE_VIEWED
  SELECTION_STARTED
  QUOTATION_SELECTED
  SELECTION_CONFIRMED
  SELECTION_CANCELLED
  DECISION_SUPERSEDED
}

model ProcurementDecision {
  id String @id @default(uuid())

  decisionNumber String @unique

  requirementId String
  comparisonId  String?

  status ProcurementDecisionStatus

  selectedQuotationId String?
  selectedVendorId    String?

  decisionReason String? @db.Text
  decisionNotes  String? @db.Text

  confirmedById String?
  confirmedAt   DateTime?

  version Int @default(1)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requirement Requirement          @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  comparison  QuotationComparison? @relation(fields: [comparisonId], references: [id], onDelete: SetNull)

  selectedQuotation Quotation? @relation(fields: [selectedQuotationId], references: [id], onDelete: SetNull)
  selectedVendor    Vendor?    @relation(fields: [selectedVendorId], references: [id], onDelete: SetNull)

  createdBy   User  @relation("ProcurementDecisionCreatedBy", fields: [createdById], references: [id])
  confirmedBy User? @relation("ProcurementDecisionConfirmedBy", fields: [confirmedById], references: [id])

  items        ProcurementDecisionItem[]
  auditEntries ProcurementDecisionAudit[]
  snapshots    ProcurementDecisionSnapshot[]

  @@index([requirementId])
  @@index([selectedVendorId])
  @@index([selectedQuotationId])
  @@index([status])
}

model ProcurementDecisionItem {
  id String @id @default(uuid())

  decisionId  String
  quotationId String
  vendorId    String

  decisionStatus ProcurementItemDecisionStatus

  selectionReason String? @db.Text

  createdAt DateTime @default(now())

  decision ProcurementDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([decisionId, quotationId])
  @@index([decisionId])
  @@index([quotationId])
  @@index([vendorId])
}

model ProcurementDecisionAudit {
  id String @id @default(uuid())

  decisionId String

  action ProcurementDecisionAuditAction

  userId String?

  previousValue Json?
  newValue      Json?

  metadata Json?

  createdAt DateTime @default(now())

  decision ProcurementDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  user     User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([decisionId])
  @@index([createdAt])
}

model ProcurementDecisionSnapshot {
  id String @id @default(uuid())

  decisionId String

  requirementData Json
  vendorData      Json
  quotationData   Json
  comparisonData  Json?

  createdAt DateTime @default(now())

  decision ProcurementDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
}

