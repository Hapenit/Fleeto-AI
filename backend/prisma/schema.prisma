datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MARKETING_USER
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  email        String    @unique
  phone        String?
  passwordHash String
  role         Role      @default(MARKETING_USER)
  status       Status    @default(ACTIVE)
  avatarUrl    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens   RefreshToken[]
  requirements    Requirement[]
  statusHistories RequirementStatusHistory[]
  aiExtractions   AIRequirementExtraction[]
  createdVendors  Vendor[]                   @relation("VendorCreator")
  updatedVendors  Vendor[]                   @relation("VendorUpdater")

  eligibilityRuns VendorEligibilityRun[]

  rankingRuns           VendorRankingRun[]
  rankingConfigurations VendorRankingWeightConfiguration[]
  outreachSelections    VendorOutreachSelection[]
  createdDecisions      ProcurementDecision[]              @relation("ProcurementDecisionCreatedBy")
  confirmedDecisions    ProcurementDecision[]              @relation("ProcurementDecisionConfirmedBy")
  procurementAudits     ProcurementDecisionAudit[]
  recordingAccessLogs   CallRecordingAccessLog[]
  requestedFollowUps    FollowUp[]                         @relation("FollowUpRequestedBy")
  assignedFollowUps     FollowUp[]                         @relation("FollowUpAssignedTo")
  createdFollowUps      FollowUp[]                         @relation("FollowUpCreatedBy")
  followUpAuditLogs     FollowUpAudit[]                    @relation("FollowUpAuditUser")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

enum RequirementStatus {
  DRAFT
  READY
  VALIDATION_REQUIRED
  MATCHING
  CALLING
  QUOTATION_RECEIVED
  UNDER_REVIEW
  VENDOR_SELECTED
  COMPLETED
  CANCELLED
}

enum CargoWeightUnit {
  KG
  TON
  GRAM
}

enum QuantityUnit {
  UNIT
  PALLET
  BOX
  CONTAINER
  LOAD
  OTHER
}

enum BudgetCurrency {
  INR
}

enum RequirementSource {
  MANUAL
  AI_ASSISTED
  IMPORTED
}

model Requirement {
  id                String @id @default(uuid())
  requirementNumber String @unique

  customerName    String?
  customerCompany String?
  customerPhone   String?
  customerEmail   String?

  pickupLocation String?
  pickupAddress  String?
  pickupCity     String?
  pickupState    String?
  pickupPincode  String?

  deliveryLocation String?
  deliveryAddress  String?
  deliveryCity     String?
  deliveryState    String?
  deliveryPincode  String?

  pickupDate       DateTime?
  pickupTime       String?
  deliveryDeadline DateTime?

  cargoType        String?
  cargoDescription String?
  cargoWeight      Float?
  cargoWeightUnit  CargoWeightUnit?

  cargoQuantity     Int?
  cargoQuantityUnit QuantityUnit?

  vehicleType     String?
  vehicleBodyType String?

  specialHandlingRequired Boolean @default(false)
  specialHandlingDetails  String?

  loadingRequired Boolean @default(false)
  loadingDetails  String?

  unloadingRequired Boolean @default(false)
  unloadingDetails  String?

  budget         Float?
  budgetCurrency BudgetCurrency?

  preferredVendorConditions String?
  additionalNotes           String?

  source RequirementSource @default(MANUAL)
  status RequirementStatus @default(DRAFT)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy     User                       @relation(fields: [createdById], references: [id])
  statusHistory RequirementStatusHistory[]
  aiExtractions AIRequirementExtraction[]

  eligibilityRuns        VendorEligibilityRun[]
  eligibilityEvaluations VendorEligibilityEvaluation[]

  rankingRuns          VendorRankingRun[]
  rankingEvaluations   VendorRankingEvaluation[]
  outreachSelections   VendorOutreachSelection[]
  voiceCalls           VoiceCall[]
  negotiationPolicies  NegotiationPolicy[]
  negotiations         NegotiationSession[]
  quotations           Quotation[]
  comparisons          QuotationComparison[]
  procurementDecisions ProcurementDecision[]
  followUps            FollowUp[]
}

model RequirementStatusHistory {
  id            String             @id @default(uuid())
  requirementId String
  fromStatus    RequirementStatus?
  toStatus      RequirementStatus
  changedById   String
  reason        String?
  metadata      Json?
  createdAt     DateTime           @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  changedBy   User        @relation(fields: [changedById], references: [id])
}

enum AIExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  NEEDS_CLARIFICATION
  FAILED
  APPLIED
  REJECTED
}

model AIRequirementExtraction {
  id            String             @id @default(uuid())
  requirementId String? // Nullable because user can start from AI extraction before creating requirement
  inputText     String
  extractedData Json?
  missingFields Json?
  ambiguities   Json?
  confidence    Float?
  summary       String?
  provider      String
  model         String
  promptVersion String
  status        AIExtractionStatus @default(PENDING)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requirement Requirement? @relation(fields: [requirementId], references: [id])
  createdBy   User         @relation(fields: [createdById], references: [id])
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum VendorLanguage {
  TA
  TA_EN
  EN
  HI
  OTHER
}

enum VendorLocationType {
  OFFICE
  YARD
  DEPOT
  GARAGE
  OTHER
}

enum ServiceRegionType {
  PICKUP
  DELIVERY
  BOTH
}

enum VendorAvailabilityStatus {
  AVAILABLE
  BUSY
  UNKNOWN
}

model Vendor {
  id                String  @id @default(uuid())
  vendorCode        String  @unique
  companyName       String
  businessName      String?
  contactPersonName String
  primaryPhone      String
  alternatePhone    String?
  whatsappPhone     String?
  email             String?

  preferredLanguage VendorLanguage @default(EN)

  status      VendorStatus @default(PENDING_VERIFICATION)
  callEnabled Boolean      @default(false)

  preferredCallStartTime String?
  preferredCallEndTime   String?
  timezone               String  @default("Asia/Kolkata")

  notes String?

  createdById String
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User  @relation("VendorCreator", fields: [createdById], references: [id])
  updatedBy User? @relation("VendorUpdater", fields: [updatedById], references: [id])

  locations           VendorLocation[]
  serviceRegions      VendorServiceRegion[]
  vehicleCapabilities VendorVehicleCapability[]
  cargoCapabilities   VendorCargoCapability[]
  availabilities      VendorAvailability[]
  performance         VendorPerformance?

  eligibilityEvaluations VendorEligibilityEvaluation[]

  rankingEvaluations  VendorRankingEvaluation[]
  outreachSelections  VendorOutreachSelection[]
  voiceCalls          VoiceCall[]
  negotiations        NegotiationSession[]
  quotations          Quotation[]
  comparisonItems     QuotationComparisonItem[]
  selectedInDecisions ProcurementDecision[]
  decisionItems       ProcurementDecisionItem[]
  followUps           FollowUp[]

  @@index([vendorCode])
  @@index([companyName])
  @@index([status])
  @@index([preferredLanguage])
  @@index([primaryPhone])
}

model VendorLocation {
  id       String @id @default(uuid())
  vendorId String

  locationType VendorLocationType @default(OFFICE)
  address      String?
  city         String
  state        String?
  pincode      String?
  latitude     Float?
  longitude    Float?

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([city])
  @@index([state])
}

model VendorServiceRegion {
  id       String @id @default(uuid())
  vendorId String

  city       String
  state      String?
  pincode    String?
  regionType ServiceRegionType @default(BOTH)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([city])
  @@index([state])
}

model VendorVehicleCapability {
  id       String @id @default(uuid())
  vendorId String

  vehicleType     String
  vehicleBodyType String?

  minimumCapacity Float?
  maximumCapacity Float?
  capacityUnit    String?

  vehicleCount Int @default(1)

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vehicleType])
  @@index([maximumCapacity])
}

model VendorCargoCapability {
  id       String @id @default(uuid())
  vendorId String

  cargoType     String
  maximumWeight Float?
  weightUnit    String?

  specialHandlingSupported Boolean @default(false)
  notes                    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([cargoType])
}

model VendorAvailability {
  id       String @id @default(uuid())
  vendorId String

  availabilityStatus VendorAvailabilityStatus @default(UNKNOWN)

  availableFrom  DateTime?
  availableUntil DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model VendorPerformance {
  id       String @id @default(uuid())
  vendorId String @unique

  totalTrips      Int @default(0)
  successfulTrips Int @default(0)
  cancelledTrips  Int @default(0)
  noShowTrips     Int @default(0)

  averageResponseTimeMinutes Float?

  averageQuotedPrice Float?
  averageFinalPrice  Float?

  currency String @default("INR")

  lastTripDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

enum EligibilityRuleType {
  MANDATORY
  CONDITIONAL
  INFORMATIONAL
}

enum RuleStatus {
  PASS
  FAIL
  REVIEW
  NOT_APPLICABLE
}

enum RuleSeverity {
  ERROR
  WARNING
  INFO
}

enum EvaluationStatus {
  COMPLETED
  NEEDS_REVIEW
  FAILED
}

enum EvaluationRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model VendorEligibilityRun {
  id            String @id @default(uuid())
  runNumber     String @unique
  requirementId String

  engineVersion String

  startedAt   DateTime?
  completedAt DateTime?

  totalVendors     Int @default(0)
  eligibleCount    Int @default(0)
  ineligibleCount  Int @default(0)
  needsReviewCount Int @default(0)

  status EvaluationRunStatus @default(QUEUED)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requirement Requirement                   @relation(fields: [requirementId], references: [id])
  createdBy   User                          @relation(fields: [createdById], references: [id])
  evaluations VendorEligibilityEvaluation[]

  @@index([requirementId])
}

model VendorEligibilityEvaluation {
  id               String @id @default(uuid())
  evaluationNumber String @unique
  runId            String
  requirementId    String
  vendorId         String

  status     EvaluationStatus
  eligible   Boolean          @default(false)
  confidence Float            @default(0)

  evaluatedAt   DateTime @default(now())
  engineVersion String

  passedRules        Int @default(0)
  failedRules        Int @default(0)
  reviewRules        Int @default(0)
  notApplicableRules Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run         VendorEligibilityRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  requirement Requirement                   @relation(fields: [requirementId], references: [id])
  vendor      Vendor                        @relation(fields: [vendorId], references: [id])
  ruleResults VendorEligibilityRuleResult[]

  @@index([runId])
  @@index([requirementId])
  @@index([vendorId])
  @@index([status])
}

model VendorEligibilityRuleResult {
  id           String @id @default(uuid())
  evaluationId String

  ruleCode String
  ruleName String

  status   RuleStatus
  severity RuleSeverity

  message String
  details Json?

  createdAt DateTime @default(now())

  evaluation VendorEligibilityEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
  @@index([ruleCode])
}

enum MatchFactorStatus {
  PASS
  PARTIAL
  WEAK
  NOT_AVAILABLE
}

enum RankingEvaluationStatus {
  RANKED
  EXCLUDED
  NEEDS_REVIEW
}

enum RankingRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum OutreachSelectionStatus {
  SELECTED
  REMOVED
}

model VendorRankingWeightConfiguration {
  id       String  @id @default(uuid())
  version  String  @unique
  isActive Boolean @default(false)

  routeWeight           Float @default(25)
  vehicleWeight         Float @default(20)
  capacityWeight        Float @default(15)
  cargoWeight           Float @default(10)
  availabilityWeight    Float @default(10)
  serviceCoverageWeight Float @default(5)
  performanceWeight     Float @default(10)
  commercialWeight      Float @default(3)
  communicationWeight   Float @default(2)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])
}

model VendorRankingRun {
  id            String @id @default(uuid())
  runNumber     String @unique
  requirementId String

  engineVersion              String
  weightConfigurationVersion String

  candidateCount Int @default(0)
  rankedCount    Int @default(0)
  excludedCount  Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  status RankingRunStatus @default(QUEUED)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requirement Requirement               @relation(fields: [requirementId], references: [id])
  createdBy   User                      @relation(fields: [createdById], references: [id])
  evaluations VendorRankingEvaluation[]

  @@index([requirementId])
}

model VendorRankingEvaluation {
  id                      String  @id @default(uuid())
  rankingNumber           String  @unique
  runId                   String
  requirementId           String
  vendorId                String
  eligibilityEvaluationId String?

  rank            Int?
  score           Float?
  scorePercentage Float?

  status RankingEvaluationStatus

  engineVersion              String
  weightConfigurationVersion String
  evaluatedAt                DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run           VendorRankingRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  requirement   Requirement               @relation(fields: [requirementId], references: [id])
  vendor        Vendor                    @relation(fields: [vendorId], references: [id])
  factorResults VendorMatchFactorResult[]

  @@index([runId])
  @@index([requirementId])
  @@index([vendorId])
  @@index([rank])
  @@index([score])
}

model VendorMatchFactorResult {
  id                  String @id @default(uuid())
  rankingEvaluationId String

  factorCode String
  factorName String

  weight          Float
  rawScore        Float
  normalizedScore Float

  status MatchFactorStatus

  reason  String?
  details Json?

  createdAt DateTime @default(now())

  evaluation VendorRankingEvaluation @relation(fields: [rankingEvaluationId], references: [id], onDelete: Cascade)

  @@index([rankingEvaluationId])
  @@index([factorCode])
}

model VendorOutreachSelection {
  id                  String  @id @default(uuid())
  requirementId       String
  vendorId            String
  rankingEvaluationId String?

  status OutreachSelectionStatus @default(SELECTED)
  notes  String?

  selectedById String
  selectedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirement Requirement @relation(fields: [requirementId], references: [id])
  vendor      Vendor      @relation(fields: [vendorId], references: [id])
  selectedBy  User        @relation(fields: [selectedById], references: [id])

  @@index([requirementId])
  @@index([vendorId])
}

enum CallStatus {
  QUEUED
  INITIATING
  RINGING
  CONNECTED
  GREETING
  CONVERSATION
  COMPLETING
  COMPLETED

  NO_ANSWER
  BUSY
  FAILED
  CANCELLED

  CALLBACK_REQUESTED
  ESCALATED
}

enum CallOutcomeType {
  QUOTE_RECEIVED
  AVAILABLE_NO_QUOTE
  NOT_AVAILABLE
  CALLBACK_REQUESTED
  NO_ANSWER
  BUSY
  FAILED
  ESCALATED
  COMPLETED_WITHOUT_QUOTE
}

model VoiceCall {
  id         String @id @default(uuid())
  callNumber String @unique

  requirementId       String
  vendorId            String
  outreachSelectionId String?

  provider       String
  providerCallId String? @unique

  status CallStatus @default(QUEUED)

  phoneNumber String
  language    String @default("TA")

  startedAt   DateTime?
  connectedAt DateTime?
  endedAt     DateTime?

  durationSeconds Int?

  failureReason String?
  recordingUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirement      Requirement           @relation(fields: [requirementId], references: [id])
  vendor           Vendor                @relation(fields: [vendorId], references: [id])
  session          CallSession?
  transcripts      CallTranscript[]
  events           CallEvent[]
  extraction       CallExtraction?
  outcome          CallOutcome?
  analysis         ConversationAnalysis?
  negotiations     NegotiationSession[]
  quotations       Quotation[]
  recording        CallRecording?
  followUpsCreated FollowUp[]
  followUpAttempts FollowUpAttempt[]     @relation("FollowUpAttemptCall")

  @@index([requirementId])
  @@index([vendorId])
  @@index([status])
  @@index([providerCallId])
}

model CallSession {
  id     String @id @default(uuid())
  callId String @unique

  sessionId String @unique

  currentState    String @default("INTRODUCTION")
  currentLanguage String @default("TA")

  conversationTurn Int @default(0)

  startedAt      DateTime?
  lastActivityAt DateTime?
  endedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  call VoiceCall @relation(fields: [callId], references: [id], onDelete: Cascade)
}

model CallTranscript {
  id     String @id @default(uuid())
  callId String

  speaker String // AI, VENDOR, SYSTEM
  text    String @db.Text

  language   String?
  confidence Float?

  sequenceNumber Int

  startTime Float?
  endTime   Float?

  createdAt DateTime @default(now())

  call     VoiceCall                     @relation(fields: [callId], references: [id], onDelete: Cascade)
  evidence ConversationFindingEvidence[]

  @@index([callId])
  @@index([sequenceNumber])
}

model CallEvent {
  id     String @id @default(uuid())
  callId String

  eventType String

  payload Json?

  timestamp DateTime @default(now())

  call VoiceCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([eventType])
}

model CallExtraction {
  id     String @id @default(uuid())
  callId String @unique

  vendorAvailable  Boolean?
  vehicleAvailable Boolean?

  quotedAmount Float?
  currency     String? @default("INR")

  pickupConfirmation   Boolean?
  deliveryConfirmation Boolean?

  estimatedDeliveryTime String?

  vendorConditions Json? @default("[]")

  vendorRemarks String? @db.Text

  confidence Float?

  rawExtraction Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  call VoiceCall @relation(fields: [callId], references: [id], onDelete: Cascade)
}

model CallOutcome {
  id     String @id @default(uuid())
  callId String @unique

  outcome CallOutcomeType

  reason  String? @db.Text
  summary String? @db.Text

  nextAction String?

  followUpAt DateTime?

  createdAt DateTime @default(now())

  call VoiceCall @relation(fields: [callId], references: [id], onDelete: Cascade)
}

// Conversation Analysis

enum ConversationAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  NEEDS_REVIEW
  FAILED
}

enum VendorInterest {
  INTERESTED
  MAYBE_INTERESTED
  NOT_INTERESTED
  UNAVAILABLE
  CALLBACK_REQUESTED
  UNKNOWN
}

enum AvailabilityStatus {
  AVAILABLE
  NOT_AVAILABLE
  PARTIALLY_AVAILABLE
  CALLBACK_REQUIRED
  UNKNOWN
}

enum ConversationQuality {
  GOOD
  PARTIAL
  POOR
  UNKNOWN
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  MIXED
  UNKNOWN
}

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
}

model ConversationAnalysis {
  id            String @id @default(uuid())
  callId        String @unique
  requirementId String
  vendorId      String

  status          ConversationAnalysisStatus @default(PENDING)
  analysisVersion String
  provider        String
  model           String

  overallSummary String? @db.Text

  vendorInterest     VendorInterest     @default(UNKNOWN)
  availabilityStatus AvailabilityStatus @default(UNKNOWN)

  quoteStatus   String?
  quoteAmount   Float?
  quoteCurrency String?

  conversationQuality    ConversationQuality @default(UNKNOWN)
  transcriptCompleteness String?             @db.Text

  sentiment           Sentiment @default(UNKNOWN)
  sentimentConfidence Float?

  analysisConfidence Float?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  call     VoiceCall                 @relation(fields: [callId], references: [id], onDelete: Cascade)
  findings ConversationFinding[]
  runs     ConversationAnalysisRun[]

  @@index([callId])
  @@index([requirementId])
  @@index([vendorId])
  @@index([status])
}

model ConversationFinding {
  id         String @id @default(uuid())
  analysisId String

  type     String
  category String?
  severity FindingSeverity @default(INFO)

  title       String?
  description String  @db.Text

  explicit   Boolean @default(false)
  confidence Float?

  createdAt DateTime @default(now())

  analysis ConversationAnalysis          @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  evidence ConversationFindingEvidence[]

  @@index([analysisId])
  @@index([type])
}

model ConversationFindingEvidence {
  id           String @id @default(uuid())
  findingId    String
  transcriptId String

  sequenceNumber Int
  startTime      Float?
  endTime        Float?

  quotedText String @db.Text

  createdAt DateTime @default(now())

  finding    ConversationFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  transcript CallTranscript      @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([findingId])
}

model ConversationAnalysisRun {
  id         String @id @default(uuid())
  analysisId String

  provider      String
  model         String
  promptVersion String

  inputHash String?

  status String

  startedAt   DateTime?
  completedAt DateTime?

  tokenUsage Int?
  latencyMs  Int?

  errorCode    String?
  errorMessage String? @db.Text

  createdAt DateTime @default(now())

  analysis ConversationAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

// =========================================================================
// MODULE 10 — AI NEGOTIATION ENGINE
// =========================================================================

enum NegotiationMode {
  MANUAL
  AI_ASSISTED
  AI_AUTONOMOUS
}

enum NegotiationStatus {
  NEGOTIATION_NOT_STARTED
  QUOTE_RECEIVED
  ASSESSING
  COUNTER_OFFER_PENDING
  COUNTER_OFFER_SENT
  VENDOR_COUNTER_RECEIVED
  VENDOR_ACCEPTED
  VENDOR_REJECTED
  PRICE_AGREED
  LIMIT_REACHED
  MAX_ATTEMPTS_REACHED
  VENDOR_NOT_FLEXIBLE
  CONDITIONS_CHANGED
  HUMAN_APPROVAL_REQUIRED
  ESCALATED
  STOPPED
  COMPLETED
  FAILED
  WAITING_FOR_CONFIRMATION
  POLICY_VIOLATION
  CALLBACK_REQUESTED
}

enum NegotiationSpeaker {
  AI
  VENDOR
  SYSTEM
  HUMAN
}

enum NegotiationAction {
  INITIAL_VENDOR_QUOTE
  AI_COUNTER_OFFER
  VENDOR_COUNTER_OFFER
  VENDOR_ACCEPTED
  VENDOR_REJECTED
  PRICE_CONFIRMATION
  CONDITION_CHANGE
  HUMAN_APPROVAL
  STOP
  ESCALATE
}

enum NegotiationResultStatus {
  PRICE_AGREED
  BEST_PRICE_RECEIVED
  NO_NEGOTIATION
  VENDOR_REJECTED
  LIMIT_REACHED
  MAX_ATTEMPTS_REACHED
  HUMAN_APPROVAL_REQUIRED
  CALLBACK_REQUIRED
  FAILED
  STOPPED
}

enum EscalationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model NegotiationPolicy {
  id            String @id @default(uuid())
  requirementId String @unique // active policy per requirement

  enabled Boolean         @default(true)
  mode    NegotiationMode @default(AI_ASSISTED)

  targetPrice            Float?
  maximumAuthorizedPrice Float?
  minimumVendorPrice     Float?

  maxAttempts      Int @default(3)
  maxCounterOffers Int @default(2)

  allowPriceIncrease      Boolean @default(false)
  allowVendorCounterOffer Boolean @default(true)

  requireHumanApprovalAbove Float?
  autoStopOnConditionChange Boolean @default(true)

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirement Requirement              @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  fields      NegotiationFieldPolicy[]
  sessions    NegotiationSession[]
}

model NegotiationFieldPolicy {
  id       String @id @default(uuid())
  policyId String

  field            String
  enabled          Boolean @default(true)
  requiresApproval Boolean @default(false)

  createdAt DateTime @default(now())

  policy NegotiationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, field])
}

model NegotiationSession {
  id                String  @id @default(uuid())
  negotiationNumber String  @unique
  callId            String  @unique
  requirementId     String
  vendorId          String
  quoteId           String?

  policyId String?

  status NegotiationStatus @default(NEGOTIATION_NOT_STARTED)
  mode   NegotiationMode   @default(AI_ASSISTED)

  targetPrice            Float?
  maximumAuthorizedPrice Float?
  minimumVendorPrice     Float?

  currency String @default("INR")

  maxAttempts  Int @default(3)
  attemptCount Int @default(0)

  currentVendorPrice   Float?
  currentOfferPrice    Float?
  finalNegotiatedPrice Float?

  startedAt   DateTime?
  completedAt DateTime?

  createdById String?
  updatedAt   DateTime @updatedAt

  call        VoiceCall          @relation(fields: [callId], references: [id], onDelete: Cascade)
  requirement Requirement        @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  vendor      Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  policy      NegotiationPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  attempts    NegotiationAttempt[]
  escalations NegotiationEscalation[]
  evidences   NegotiationEvidence[]
  result      NegotiationResult?

  @@index([callId])
  @@index([requirementId])
  @@index([vendorId])
  @@index([status])
}

model NegotiationAttempt {
  id        String @id @default(uuid())
  sessionId String

  attemptNumber Int

  speaker NegotiationSpeaker
  action  NegotiationAction

  proposedAmount Float?
  currency       String?
  previousAmount Float?

  reason   String? @db.Text
  message  String? @db.Text
  language String?

  status String?

  createdAt DateTime @default(now())

  session  NegotiationSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evidence NegotiationEvidence[]
}

model NegotiationEvidence {
  id        String  @id @default(uuid())
  sessionId String
  attemptId String?

  sourceType String
  sourceId   String?

  sequenceNumber Int?
  quotedText     String? @db.Text

  createdAt DateTime @default(now())

  session NegotiationSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attempt NegotiationAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model NegotiationEscalation {
  id        String @id @default(uuid())
  sessionId String

  reason      String
  description String?          @db.Text
  status      EscalationStatus @default(OPEN)

  assignedToId String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  session NegotiationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model NegotiationResult {
  id        String @id @default(uuid())
  sessionId String @unique

  status NegotiationResultStatus

  initialVendorQuote   Float?
  finalVendorQuote     Float?
  finalNegotiatedPrice Float?

  currency String?

  vendorAccepted  Boolean @default(false)
  vendorConfirmed Boolean @default(false)

  conditions      Json?
  unansweredItems Json?

  reason  String? @db.Text
  summary String? @db.Text

  createdAt DateTime @default(now())

  session NegotiationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

