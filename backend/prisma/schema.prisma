model Quotation {
  id              String @id @default(uuid())
  quotationNumber String @unique

  requirementId String
  vendorId      String
  callId        String?
  negotiationId String?

  status QuotationStatus @default(DRAFT)

  version           Int     @default(1)
  parentQuotationId String?

  initialAmount Decimal? @db.Decimal(12, 2)
  finalAmount   Decimal? @db.Decimal(12, 2)

  currency String @default("INR") @db.Char(3)

  vendorConfirmed Boolean   @default(false)
  confirmationAt  DateTime?

  validFrom  DateTime?
  validUntil DateTime?

  estimatedPickupDate       DateTime?
  estimatedDeliveryDate     DateTime?
  estimatedDeliveryDuration String?

  notes String? @db.Text

  source QuotationSource @default(MANUAL)

  createdById String
  updatedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirement         Requirement                    @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  vendor              Vendor                         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  call                VoiceCall?                     @relation(fields: [callId], references: [id], onDelete: SetNull)
  parentQuotation     Quotation?                     @relation("QuotationHistory", fields: [parentQuotationId], references: [id], onDelete: SetNull)
  childQuotations     Quotation[]                    @relation("QuotationHistory")
  charges             QuotationCharge[]
  conditions          QuotationCondition[]
  evidence            QuotationEvidence[]
  confirmations       QuotationConfirmation[]
  paymentTerms        QuotationPaymentTerm[]
  requirementSnaps    QuotationRequirementSnapshot[]
  reviews             QuotationReview[]
  comparisonItems     QuotationComparisonItem[]
  shortlists          QuotationComparisonShortlist[]
  selectedInDecisions ProcurementDecision[]
  decisionItems       ProcurementDecisionItem[]

  @@index([requirementId])
  @@index([vendorId])
  @@index([status])
  @@index([quotationNumber])
}

model QuotationCharge {
  id          String @id @default(uuid())
  quotationId String

  type QuotationChargeType
  name String?

  amount   Decimal? @db.Decimal(12, 2)
  currency String?  @default("INR") @db.Char(3)

  status          QuotationChargeStatus          @default(UNKNOWN)
  calculationType QuotationChargeCalculationType @default(FIXED)

  description String? @db.Text

  source     QuotationSource @default(MANUAL)
  evidenceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model QuotationCondition {
  id          String @id @default(uuid())
  quotationId String

  type        QuotationConditionType
  description String                 @db.Text

  status String?

  explicit   Boolean @default(false)
  confidence Float?

  evidenceId String?

  createdAt DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model QuotationEvidence {
  id          String @id @default(uuid())
  quotationId String

  field      String
  sourceType QuotationEvidenceSource
  sourceId   String?

  transcriptId   String?
  sequenceNumber Int?

  quotedText String @db.Text

  createdAt DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model QuotationConfirmation {
  id          String @id @default(uuid())
  quotationId String

  confirmedBy      String?
  confirmationType String

  confirmedAmount Decimal? @db.Decimal(12, 2)
  currency        String?  @default("INR") @db.Char(3)

  confirmedAt DateTime @default(now())

  callId         String?
  transcriptId   String?
  sequenceNumber Int?

  evidenceText String? @db.Text

  createdAt DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model QuotationPaymentTerm {
  id          String @id @default(uuid())
  quotationId String

  type        QuotationPaymentTermType
  description String?                  @db.Text

  advanceAmount     Decimal? @db.Decimal(12, 2)
  advancePercentage Float?

  remainingPaymentCondition String? @db.Text

  evidenceId String?

  createdAt DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model QuotationRequirementSnapshot {
  id          String @id @default(uuid())
  quotationId String

  pickupLocation   String
  deliveryLocation String
  cargoType        String
  cargoWeight      Float
  cargoWeightUnit  CargoWeightUnit
  vehicleType      String
  pickupDate       DateTime?
  deliveryDeadline DateTime?

  createdAt DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model QuotationReview {
  id          String @id @default(uuid())
  quotationId String

  reviewedById String

  action String
  reason String? @db.Text

  createdAt DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

