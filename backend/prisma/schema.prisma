model FollowUp {
  id             String @id @default(cuid())
  followUpNumber String @unique

  requirementId    String
  vendorId         String
  sourceCallId     String?
  parentFollowUpId String?

  type   FollowUpType
  reason FollowUpReason
  status FollowUpStatus

  scheduledAt DateTime?
  expiresAt   DateTime?

  attemptNumber Int @default(1)
  maxAttempts   Int @default(3)

  requestedByUserId String?
  assignedToUserId  String?

  requestedTimeText   String?
  requestedTimeSource FollowUpTimeSource?

  notes String?

  completedAt DateTime?
  cancelledAt DateTime?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requirement Requirement @relation(fields: [requirementId], references: [id])
  vendor      Vendor      @relation(fields: [vendorId], references: [id])

  sourceCall     VoiceCall? @relation(fields: [sourceCallId], references: [id])
  parentFollowUp FollowUp?  @relation("FollowUpChain", fields: [parentFollowUpId], references: [id])
  childFollowUps FollowUp[] @relation("FollowUpChain")

  requestedByUser User? @relation("FollowUpRequestedBy", fields: [requestedByUserId], references: [id])
  assignedToUser  User? @relation("FollowUpAssignedTo", fields: [assignedToUserId], references: [id])
  createdBy       User  @relation("FollowUpCreatedBy", fields: [createdById], references: [id])

  attempts     FollowUpAttempt[]
  auditEntries FollowUpAudit[]

  @@index([requirementId])
  @@index([vendorId])
  @@index([sourceCallId])
  @@index([status])
  @@index([scheduledAt])
}

model FollowUpAttempt {
  id String @id @default(cuid())

  followUpId String
  callId     String?

  attemptNumber Int

  status FollowUpAttemptStatus

  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  result FollowUpAttemptResult?

  failureReason String?

  createdAt DateTime @default(now())

  followUp FollowUp   @relation(fields: [followUpId], references: [id])
  call     VoiceCall? @relation("FollowUpAttemptCall", fields: [callId], references: [id])

  @@unique([followUpId, attemptNumber])
  @@index([followUpId])
  @@index([callId])
}

model FollowUpPolicy {
  id String @id @default(cuid())

  name String

  enabled Boolean @default(true)

  maxAttempts Int @default(3)

  retryOnNoAnswer Boolean @default(true)
  retryOnBusy     Boolean @default(true)
  retryOnFailure  Boolean @default(true)

  retryDelayMinutes       Int @default(30)
  secondRetryDelayMinutes Int @default(60)
  callbackGraceMinutes    Int @default(10)

  callingWindowStart String?
  callingWindowEnd   String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FollowUpAudit {
  id String @id @default(cuid())

  followUpId String
  action     FollowUpAuditAction
  userId     String?

  previousStatus FollowUpStatus?
  newStatus      FollowUpStatus?

  metadata Json?

  createdAt DateTime @default(now())

  followUp FollowUp @relation(fields: [followUpId], references: [id])
  user     User?    @relation("FollowUpAuditUser", fields: [userId], references: [id])

  @@index([followUpId])
  @@index([createdAt])
}

enum AIProvider {
  GEMINI
  OPENAI
  OTHER
}

model AIProviderConfig {
  id          String     @id @default(cuid())
  provider    AIProvider
  displayName String

  enabled        Boolean @default(false)
  secretRef      String?
  baseUrl        String?
  organizationId String?

  priority   Int @default(100)
  timeoutMs  Int @default(30000)
  maxRetries Int @default(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models AIModelConfig[]
}

model AIModelConfig {
  id String @id @default(cuid())

  providerId String
  provider   AIProviderConfig @relation(fields: [providerId], references: [id], onDelete: Cascade)

  modelName String
  enabled   Boolean @default(true)

  inputPrice    Decimal?
  outputPrice   Decimal?
  maxTokens     Int?
  temperature   Decimal?
  contextWindow Int?
  capabilities  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIFeatureConfig {
  id         String @id @default(cuid())
  featureKey String @unique

  enabled    Boolean @default(true)
  providerId String?
  modelId    String?

  temperature        Decimal?
  maxTokens          Int?
  timeoutMs          Int?
  requireHumanReview Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AIPromptStatus {
  DRAFT
  TESTING
  PUBLISHED
  RETIRED
}

model AIPrompt {
  id        String @id @default(cuid())
  promptKey String
  version   Int
  name      String

  description  String?
  systemPrompt String
  userTemplate String?

  status AIPromptStatus @default(DRAFT)

  createdById   String
  publishedById String?

  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  retiredAt   DateTime?

  @@unique([promptKey, version])
}

enum VoiceLanguage {
  TA
  TA_EN
  EN
  HI
}

model VoiceConfig {
  id String @id @default(cuid())

  language    VoiceLanguage
  sttProvider String
  ttsProvider String
  voice       String?

  speechSpeed        Decimal?
  silenceTimeoutMs   Int      @default(5000)
  bargeInEnabled     Boolean  @default(true)
  maxCallDurationSec Int      @default(900)

  recordingEnabled    Boolean @default(false)
  aiDisclosureEnabled Boolean @default(true)
  enabled             Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TelephonyConfig {
  id       String  @id @default(cuid())
  provider String
  enabled  Boolean @default(false)
  callerId String?

  recordingEnabled Boolean @default(false)
  callTimeoutSec   Int     @default(60)

  webhookEnabled        Boolean @default(true)
  mediaStreamingEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CallingPolicy {
  id String @id @default(cuid())

  name    String
  enabled Boolean @default(true)

  maxCallDurationSec Int    @default(900)
  callingWindowStart String @default("09:00")
  callingWindowEnd   String @default("20:00")
  maxAttempts        Int    @default(3)

  retryOnNoAnswer Boolean @default(true)
  retryOnBusy     Boolean @default(true)
  retryOnFailure  Boolean @default(true)

  recordingEnabled     Boolean @default(false)
  aiDisclosureRequired Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSetting {
  id String @id @default(cuid())

  category String
  key      String
  value    Json

  description String?
  updatedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, key])
}

model AIUsageRecord {
  id String @id @default(cuid())

  provider   String
  model      String
  featureKey String

  requirementId String?
  vendorId      String?
  callId        String?

  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?

  estimatedCost Decimal?
  currency      String?
  latencyMs     Int?

  success   Boolean
  errorCode String?

  promptKey     String?
  promptVersion Int?

  createdAt DateTime @default(now())
}

model ProviderPricingConfig {
  id String @id @default(cuid())

  provider String
  model    String

  inputPrice  Decimal?
  outputPrice Decimal?

  currency      String   @default("USD")
  effectiveFrom DateTime

  createdAt DateTime @default(now())
}
