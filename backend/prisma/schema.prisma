// MODULE 12 — QUOTATION COMPARISON ENGINE
// =========================================================================

enum ComparisonStatus {
  DRAFT
  READY
  UNDER_REVIEW
  DECISION_PENDING
  COMPLETED
  CANCELLED
  SUPERSEDED
}

enum RequirementMismatchType {
  PICKUP_LOCATION
  DELIVERY_LOCATION
  CARGO_TYPE
  CARGO_WEIGHT
  VEHICLE_TYPE
  VEHICLE_BODY
  PICKUP_DATE
  DELIVERY_DEADLINE
  SPECIAL_HANDLING
  CAPACITY
  OTHER
}

enum RequirementMismatchSeverity {
  INFO
  WARNING
  CRITICAL
}

model QuotationComparison {
  id               String @id @default(uuid())
  comparisonNumber String @unique

  requirementId String

  status  ComparisonStatus @default(DRAFT)
  version Int              @default(1)

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirement          Requirement                    @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  items                QuotationComparisonItem[]
  shortlists           QuotationComparisonShortlist[]
  states               ComparisonState[]
  procurementDecisions ProcurementDecision[]
}

model QuotationComparisonItem {
  id           String @id @default(uuid())
  comparisonId String
  quotationId  String
  vendorId     String

  displayOrder Int @default(0)

  finalAmount Decimal? @db.Decimal(12, 2)
  currency    String?  @default("INR") @db.Char(3)

  knownAdditionalCharges       Int      @default(0)
  knownAdditionalChargesAmount Decimal? @db.Decimal(12, 2)

  unknownChargeCount Int @default(0)

  knownTotalAmount  Decimal? @db.Decimal(12, 2)
  totalAmountStatus String?

  deliveryDuration String?
  quoteValidity    DateTime?

  vendorConfirmed   Boolean @default(false)
  quoteCompleteness Int     @default(0)

  createdAt DateTime @default(now())

  comparison QuotationComparison   @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  quotation  Quotation             @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  vendor     Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  mismatches RequirementMismatch[]
}

model RequirementMismatch {
  id               String @id @default(uuid())
  comparisonItemId String

  type     RequirementMismatchType
  severity RequirementMismatchSeverity

  requirementValue String? @db.Text
  quotationValue   String? @db.Text

  description String? @db.Text
  source      String?

  createdAt DateTime @default(now())

  item QuotationComparisonItem @relation(fields: [comparisonItemId], references: [id], onDelete: Cascade)
}

model QuotationComparisonShortlist {
  id           String @id @default(uuid())
  comparisonId String
  quotationId  String
  createdById  String

  createdAt DateTime  @default(now())
  removedAt DateTime?

  comparison QuotationComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  quotation  Quotation           @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model ComparisonState {
  id           String @id @default(uuid())
  comparisonId String
  userId       String

  selectedColumns String? @db.Text
  sortField       String?
  sortDirection   String?
  filters         String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comparison QuotationComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
}

