# Copy this file to backend/.env for local development.
# Never commit backend/.env or put backend secrets in frontend variables.
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/fleeto?schema=public"
JWT_ACCESS_SECRET="<generate-with-openssl-rand-base64-48>"
NODE_ENV="development"
PORT="3001"
METRICS_TOKEN=""
ENABLE_API_DOCS="false"

# Comma-separated frontend origins allowed to call the backend and connect to live voice.
FRONTEND_URL="http://localhost:3000"

# AI providers (keep keys on the backend only). Leave empty for simulation/local tests.
GEMINI_API_KEY=""
CONVERSATION_AI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
AI_ANALYSIS_MODEL="gemini-2.5-flash"
AI_NEGOTIATION_MODEL="gemini-2.5-flash"
VOICE_AGENT_MODE="SIMULATION"

# Used only by the demo database seed command. Set unique strong values before
# seeding a non-disposable environment. Do not use the seed script in production.
ADMIN_PASSWORD=""
MARKETING_PASSWORD=""

# Used only after a real telephony adapter and secured provider callback exist.
VOICE_WEBHOOK_PUBLIC_URL="http://localhost:3001/api/webhooks/telephony/exotel"

# Exotel credentials are intentionally not included. The current Exotel provider
# is a mock and no callback route currently reads these values. Never copy
# credentials shared in chat; rotate them and add replacements only to the
# deployment secret manager after the real AgentStream integration is complete.
# EXOTEL_API_KEY=""
# EXOTEL_API_TOKEN=""
# EXOTEL_ACCOUNT_SID=""
# EXOTEL_WEBHOOK_SECRET=""
#
# Sarvam and WhatsApp credentials are omitted because no live adapters read them.
# JWT_REFRESH_SECRET, ACCESS_TOKEN_EXPIRES_IN, and REFRESH_TOKEN_EXPIRES_IN are
# also not currently read by the app; refresh tokens are opaque DB-backed values.
